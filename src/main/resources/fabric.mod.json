{
  "schemaVersion": 1,
  "id": "vrkmod",
  "version": "${version}",
  "name": "Vanilla RP Keeper",
  "description": "Always pinned Vanilla resource pack.",
  "authors": [
    "404"
  ],
  "logo": "assets/vrkmod/icon.png",
  "contact": {
    "issues": "https://github.com/404Setup/VanillaRPKeeper/issues",
    "sources": "https://github.com/404Setup/VanillaRPKeeper",
    "homepage": "https://www.curseforge.com/minecraft/mc-mods/vanilla-rp-keeper"
  },
  "license": "LGPL-3.0",
  "environment": "client",
  "entrypoints": {
    "main": [
      "one.pkg.vrkmod.ModMain"
    ]
  },
  "accessWidener": "vrkmod.accesswidener",
  "mixins": [
    "vrkmod.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=${loader_version}",
    "fabric": "*",
    "minecraft": "${version_range}"
  }
}